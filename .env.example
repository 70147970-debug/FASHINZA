# Fashinza settings. Copy this file to .env (repository root) and fill in the values.
# server/.env (see server/.env.example, for email) overrides this file, and variables set in the real
# environment override both. Never commit .env: it holds secrets.

# ── Database ──────────────────────────────────────────────
# MongoDB connection string. Transactions need a replica set (a single-node one is fine locally).
MONGODB_URI=mongodb://127.0.0.1:27017/fashinza?replicaSet=rs0

# ── Web addresses ─────────────────────────────────────────
# Public address of the web app (links in emails, sandbox payment redirects).
# Locally `npm run dev` serves the app at http://localhost:5173; `npm start` serves it at http://localhost:4000.
APP_URL=http://localhost:5173
# Port of the Express server (default 4000)
# PORT=4000

# ── Payments (sandbox) ────────────────────────────────────
PAYMENT_PROVIDER=sandbox
# At least 32 random characters, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_SANDBOX_SECRET=

# ── Seed (npm run seed) ───────────────────────────────────
# Administrators cannot self-register; the seed creates this account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set to 1 to also create clearly labelled "(Demo)" brand and factory accounts
SEED_DEMO=1
SEED_DEMO_PASSWORD=

# ── Optional ──────────────────────────────────────────────
# Where private uploads are stored (default ./uploads). Must not be inside public/ or client/.
# UPLOAD_DIR=./uploads
# Email shown on the contact page and footer (inlined into the client at build time)
# NEXT_PUBLIC_CONTACT_EMAIL=contact@fashinza.example
# Multiplier for all rate limits (default 1). Only raise it for automated tests.
# RATE_LIMIT_SCALE=1
# Disposable databases for automated tests (names must contain "test" / "e2e")
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/fashinza_test?replicaSet=rs0
# E2E_MONGODB_URI=mongodb://127.0.0.1:27017/fashinza_e2e?replicaSet=rs0
