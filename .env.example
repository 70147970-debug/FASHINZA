# ── Required ──────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fashinza"
# Public base URL of this app (used for password-reset links and sandbox webhook delivery)
APP_URL="http://localhost:3000"

# ── Payments (sandbox) ────────────────────────────────────
PAYMENT_PROVIDER="sandbox"
# At least 32 random characters, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_SANDBOX_SECRET=""

# ── Seed (npm run db:seed) ────────────────────────────────
# Administrators cannot self-register; the seed creates this account (password: 12+ characters).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
# Set to 1 to also create clearly labelled "(Demo)" brand and factory accounts
SEED_DEMO="0"
SEED_DEMO_PASSWORD=""

# ── Optional ──────────────────────────────────────────────
# Where private uploads are stored (default ./uploads). Must not be inside /public.
# UPLOAD_DIR="/var/lib/fashinza/uploads"
# Multiplier for all rate limits (default 1). Only raise it for automated tests.
# RATE_LIMIT_SCALE="1"
# Email shown on the contact page and footer
# NEXT_PUBLIC_CONTACT_EMAIL="contact@example.com"
# Separate, disposable databases for automated tests (names must contain "test" / "e2e")
# TEST_DATABASE_URL="postgresql://USER@localhost/fashinza_test"
# E2E_DATABASE_URL="postgresql://USER@localhost/fashinza_e2e"
# docker-compose only
# POSTGRES_PASSWORD=""
