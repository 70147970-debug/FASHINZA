// Fashinza — database schema (PostgreSQL, Prisma 7)
// Money is stored as Decimal(12,2). Files are stored outside the database;
// only metadata and the storage key are kept here. All timestamps are UTC.
//
// Organisations: each brand or factory account is one organisation. BrandProfile and
// ManufacturerProfile hold the organisation details and every business record is owned
// by that account's user id, which is what tenant-isolation checks compare against.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  BRAND
  MANUFACTURER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum VerificationStatus {
  UNSUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum GarmentCategory {
  T_SHIRTS
  SHIRTS
  DRESSES
  DENIM
  TROUSERS
  ACTIVEWEAR
  OUTERWEAR
  KNITWEAR
  HOODIES_SWEATSHIRTS
  KIDSWEAR
  SLEEPWEAR
  ACCESSORIES
}

enum CapabilityKind {
  PRODUCTION
  FABRIC
  FINISHING
}

enum DocumentType {
  CERTIFICATION
  BUSINESS_REGISTRATION
  OTHER
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ProjectStatus {
  DRAFT
  SUBMITTED
  QUOTING
  QUOTATION_ACCEPTED
  IN_PRODUCTION
  QUALITY_CHECK
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
}

enum AttachmentKind {
  TECH_PACK
  SKETCH
  OTHER
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  REVISION_REQUESTED
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum OrderStatus {
  IN_PRODUCTION
  QUALITY_CHECK
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
}

enum MilestoneStage {
  FABRIC_SOURCING
  SAMPLING
  CUTTING
  STITCHING
  FINISHING
  QUALITY_CONTROL
  SHIPPING
  DELIVERY
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  AWAITING_APPROVAL
  COMPLETED
  BLOCKED
}

enum ResponsibleParty {
  BRAND
  MANUFACTURER
}

enum SampleStatus {
  SUBMITTED
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

enum QCResult {
  PASS
  FAIL
}

enum DefectSeverity {
  CRITICAL
  MAJOR
  MINOR
}

enum QCDecision {
  PENDING
  ACCEPTED
  REJECTED
}

enum ReworkStatus {
  OPEN
  COMPLETED
}

enum PaymentMilestoneStatus {
  SCHEDULED
  DUE
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

enum TransactionType {
  CHARGE
  REFUND
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum NotificationType {
  PROJECT_SUBMITTED
  MATCH_FOUND
  QUOTATION_RECEIVED
  QUOTATION_REVISION_REQUESTED
  QUOTATION_REVISED
  QUOTATION_ACCEPTED
  QUOTATION_REJECTED
  ORDER_CREATED
  MILESTONE_UPDATED
  ORDER_DELAYED
  SAMPLE_SUBMITTED
  SAMPLE_DECISION
  QC_REPORT_SUBMITTED
  QC_OUTCOME
  PAYMENT_UPDATE
  ORDER_SHIPPED
  ORDER_DELIVERED
  VERIFICATION_DECISION
  DISPUTE_UPDATE
  MESSAGE_RECEIVED
  ACCOUNT_STATUS
  SYSTEM
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum IssueStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum IssueCategory {
  QUALITY
  DELIVERY
  PAYMENT
  COMMUNICATION
  OTHER
}

// ─────────────────────── Users & authentication ───────────────────────
// User / Session / Account / Verification keep the Better Auth column layout.
// Session.token stores a SHA-256 hash of the cookie value, never the raw token.
// Account.password stores an scrypt hash for providerId = "credential".

model User {
  id               String     @id
  name             String
  email            String     @unique
  emailVerified    Boolean    @default(false)
  image            String?
  role             Role       @default(BRAND)
  status           UserStatus @default(ACTIVE)
  statusReason     String?
  profileCompleted Boolean    @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  sessions            Session[]
  accounts            Account[]
  brandProfile        BrandProfile?
  manufacturerProfile ManufacturerProfile?
  projects            Project[]             @relation("BrandProjects")
  quotations          Quotation[]           @relation("ManufacturerQuotations")
  brandOrders         Order[]               @relation("BrandOrders")
  manufacturerOrders  Order[]               @relation("ManufacturerOrders")
  notifications       Notification[]
  qcReports           QCReport[]
  milestoneUpdates    ProductionMilestone[]
  activities          ActivityLog[]
  auditLogs           AuditLog[]
  issues              IssueReport[]
  uploads             ProjectAttachment[]
  matchResults        MatchResult[]
  samples             Sample[]              @relation("SampleSubmitter")
  sampleReviews       Sample[]              @relation("SampleReviewer")
  evidence            MilestoneEvidence[]
  messages            Message[]

  @@index([role, status])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

/// One-time tokens (password reset). `value` holds a SHA-256 hash of the token.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ───────────────────────────── Profiles ─────────────────────────────

model BrandProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  description String?
  country     String
  city        String?
  website     String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("brand_profile")
}

model ManufacturerProfile {
  id                      String             @id @default(cuid())
  userId                  String             @unique
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName            String
  description             String
  country                 String
  city                    String
  categories              GarmentCategory[]
  minOrderQuantity        Int
  maxMonthlyCapacity      Int
  typicalLeadTimeDays     Int                @default(45)
  contactName             String
  contactEmail            String
  contactPhone            String?
  website                 String?
  verificationStatus      VerificationStatus @default(UNSUBMITTED)
  verificationNote        String?
  verificationRequestedAt DateTime?
  verifiedAt              DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  capabilities ManufacturerCapability[]
  documents    ManufacturerDocument[]

  @@index([verificationStatus])
  @@index([country])
  @@map("manufacturer_profile")
}

model ManufacturerCapability {
  id        String              @id @default(cuid())
  profileId String
  profile   ManufacturerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind      CapabilityKind
  name      String

  @@unique([profileId, kind, name])
  @@index([name])
  @@map("manufacturer_capability")
}

model ManufacturerDocument {
  id                String              @id @default(cuid())
  profileId         String
  profile           ManufacturerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type              DocumentType
  certificationName String?
  fileKey           String              @unique
  fileName          String
  mimeType          String
  size              Int
  status            DocumentStatus      @default(PENDING)
  reviewNote        String?
  reviewedAt        DateTime?
  createdAt         DateTime            @default(now())

  @@index([profileId, status])
  @@map("manufacturer_document")
}

// ───────────────────────────── Projects ─────────────────────────────

/// Fields other than name and category may be empty while the project is a DRAFT;
/// submission validates the complete project.
model Project {
  id                     String          @id @default(cuid())
  brandId                String
  brand                  User            @relation("BrandProjects", fields: [brandId], references: [id], onDelete: Cascade)
  name                   String
  category               GarmentCategory
  description            String?
  quantity               Int?
  maxMoq                 Int?
  targetUnitPrice        Decimal?        @db.Decimal(12, 2)
  currency               String          @default("USD")
  deadline               DateTime?
  fabricRequirements     String?
  fabrics                String[]
  sizes                  String[]
  colors                 String?
  additionalInstructions String?
  requiredCapabilities   String[]
  preferredCountry       String?
  requiredCertifications String[]
  sustainabilityNotes    String?
  status                 ProjectStatus   @default(DRAFT)
  wizardStep             Int             @default(1)
  submittedAt            DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  attachments  ProjectAttachment[]
  revisions    ProjectRevision[]
  quotations   Quotation[]
  order        Order?
  activities   ActivityLog[]
  issues       IssueReport[]
  matchResults MatchResult[]

  @@index([brandId, status])
  @@index([status, category])
  @@map("project")
}

/// TECH_PACK attachments are versioned per project; the highest version is the current one.
model ProjectAttachment {
  id           String         @id @default(cuid())
  projectId    String
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User           @relation(fields: [uploadedById], references: [id])
  kind         AttachmentKind @default(OTHER)
  version      Int?
  notes        String?
  fileKey      String         @unique
  fileName     String
  mimeType     String
  size         Int
  createdAt    DateTime       @default(now())

  @@unique([projectId, kind, version])
  @@index([projectId])
  @@map("project_attachment")
}

/// Snapshot of changed fields when a brand edits a project that already has quotations.
model ProjectRevision {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changedById String
  changes     Json
  createdAt   DateTime @default(now())

  @@index([projectId, createdAt])
  @@map("project_revision")
}

/// Output of the rule-based matching engine. Only eligible factories get a row;
/// a row is what lets a manufacturer see and quote on the project.
model MatchResult {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  manufacturerId String
  manufacturer   User      @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  score          Decimal   @db.Decimal(5, 2)
  breakdown      Json
  reasons        String[]
  algorithm      String
  invitedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@unique([projectId, manufacturerId])
  @@index([manufacturerId, createdAt])
  @@map("match_result")
}

// ──────────────────────── Quotations & orders ────────────────────────

/// One quotation per manufacturer per project; revisions keep the history.
/// unitPrice is the per-unit making (CMT) cost; the other per-unit costs are added to it.
model Quotation {
  id                   String          @id @default(cuid())
  projectId            String
  project              Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  manufacturerId       String
  manufacturer         User            @relation("ManufacturerQuotations", fields: [manufacturerId], references: [id], onDelete: Cascade)
  quantity             Int             @default(0)
  unitPrice            Decimal         @db.Decimal(12, 2)
  fabricCostPerUnit    Decimal         @default(0) @db.Decimal(12, 2)
  finishingCostPerUnit Decimal         @default(0) @db.Decimal(12, 2)
  packagingCostPerUnit Decimal         @default(0) @db.Decimal(12, 2)
  logisticsCost        Decimal         @default(0) @db.Decimal(12, 2)
  taxPercent           Decimal         @default(0) @db.Decimal(5, 2)
  subtotal             Decimal         @default(0) @db.Decimal(14, 2)
  taxAmount            Decimal         @default(0) @db.Decimal(14, 2)
  totalAmount          Decimal         @default(0) @db.Decimal(14, 2)
  currency             String
  minQuantity          Int
  productionDays       Int
  samplingCost         Decimal?        @db.Decimal(12, 2)
  notes                String?
  validUntil           DateTime
  status               QuotationStatus @default(DRAFT)
  revisionRequest      String?
  version              Int             @default(1)
  submittedAt          DateTime?
  decidedAt            DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  revisions QuotationRevision[]
  order     Order?

  @@unique([projectId, manufacturerId])
  @@index([manufacturerId, status])
  @@index([projectId, status])
  @@map("quotation")
}

model QuotationRevision {
  id             String    @id @default(cuid())
  quotationId    String
  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  version        Int
  unitPrice      Decimal   @db.Decimal(12, 2)
  minQuantity    Int
  productionDays Int
  samplingCost   Decimal?  @db.Decimal(12, 2)
  notes          String?
  validUntil     DateTime
  snapshot       Json?
  createdAt      DateTime  @default(now())

  @@unique([quotationId, version])
  @@map("quotation_revision")
}

/// projectId and quotationId are unique, so a project can never have two orders.
model Order {
  id                     String         @id @default(cuid())
  reference              String         @unique
  projectId              String         @unique
  project                Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quotationId            String         @unique
  quotation              Quotation      @relation(fields: [quotationId], references: [id])
  brandId                String
  brand                  User           @relation("BrandOrders", fields: [brandId], references: [id])
  manufacturerId         String
  manufacturer           User           @relation("ManufacturerOrders", fields: [manufacturerId], references: [id])
  quantity               Int
  unitPrice              Decimal        @db.Decimal(12, 2)
  totalAmount            Decimal        @default(0) @db.Decimal(14, 2)
  currency               String
  agreedTerms            Json?
  status                 OrderStatus    @default(IN_PRODUCTION)
  currentStage           MilestoneStage @default(FABRIC_SOURCING)
  expectedCompletionDate DateTime
  trackingInfo           String?
  shippedAt              DateTime?
  deliveredAt            DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  milestones        ProductionMilestone[]
  qcReports         QCReport[]
  activities        ActivityLog[]
  issues            IssueReport[]
  samples           Sample[]
  reworkTasks       ReworkTask[]
  paymentMilestones PaymentMilestone[]
  messages          Message[]

  @@index([brandId, status])
  @@index([manufacturerId, status])
  @@index([status, expectedCompletionDate])
  @@map("order")
}

model ProductionMilestone {
  id                String           @id @default(cuid())
  orderId           String
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage             MilestoneStage
  sequence          Int
  status            MilestoneStatus  @default(NOT_STARTED)
  responsibleParty  ResponsibleParty @default(MANUFACTURER)
  evidenceRequired  Boolean          @default(false)
  plannedStart      DateTime?
  plannedEnd        DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  responsibleUserId String?
  responsibleUser   User?            @relation(fields: [responsibleUserId], references: [id])
  notes             String?
  isDelayed         Boolean          @default(false)
  delayReason       String?
  updatedAt         DateTime         @updatedAt

  evidence MilestoneEvidence[]
  messages Message[]

  @@unique([orderId, stage])
  @@unique([orderId, sequence])
  @@index([status, plannedEnd])
  @@map("production_milestone")
}

model MilestoneEvidence {
  id           String              @id @default(cuid())
  milestoneId  String
  milestone    ProductionMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User                @relation(fields: [uploadedById], references: [id])
  fileKey      String              @unique
  fileName     String
  mimeType     String
  size         Int
  note         String?
  createdAt    DateTime            @default(now())

  @@index([milestoneId])
  @@map("milestone_evidence")
}

// ───────────────────────── Sampling & quality ─────────────────────────

model Sample {
  id            String       @id @default(cuid())
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  round         Int
  description   String
  revisionNotes String?
  status        SampleStatus @default(SUBMITTED)
  feedback      String?
  submittedById String
  submittedBy   User         @relation("SampleSubmitter", fields: [submittedById], references: [id])
  reviewedById  String?
  reviewedBy    User?        @relation("SampleReviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  createdAt     DateTime     @default(now())

  photos SamplePhoto[]

  @@unique([orderId, round])
  @@map("sample")
}

model SamplePhoto {
  id       String @id @default(cuid())
  sampleId String
  sample   Sample @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  fileKey  String @unique
  fileName String
  mimeType String
  size     Int

  @@index([sampleId])
  @@map("sample_photo")
}

/// Inspection record. Acceptance numbers are stored with the report so that later
/// changes to the sampling-plan configuration never alter a historical result.
model QCReport {
  id                 String     @id @default(cuid())
  orderId            String
  order              Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inspectorId        String
  inspector          User       @relation(fields: [inspectorId], references: [id])
  inspectionDate     DateTime
  batchSize          Int        @default(0)
  sampleSize         Int
  inspectionStandard String     @default("")
  aqlMajor           Decimal?   @db.Decimal(4, 2)
  aqlMinor           Decimal?   @db.Decimal(4, 2)
  acceptMajor        Int?
  acceptMinor        Int?
  criticalCount      Int        @default(0)
  majorCount         Int        @default(0)
  minorCount         Int        @default(0)
  defectiveCount     Int
  defectRate         Decimal    @db.Decimal(5, 2)
  defectDescriptions String?
  correctiveActions  String?
  notes              String?
  result             QCResult
  brandDecision      QCDecision @default(PENDING)
  brandDecisionNote  String?
  decidedAt          DateTime?
  createdAt          DateTime   @default(now())

  photos  QCReportPhoto[]
  defects QCDefect[]
  rework  ReworkTask?

  @@index([orderId, createdAt])
  @@map("qc_report")
}

model QCDefect {
  id       String         @id @default(cuid())
  reportId String
  report   QCReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  category String
  severity DefectSeverity
  count    Int

  @@index([reportId])
  @@map("qc_defect")
}

model QCReportPhoto {
  id       String   @id @default(cuid())
  reportId String
  report   QCReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  fileKey  String   @unique
  fileName String
  mimeType String
  size     Int

  @@map("qc_report_photo")
}

model ReworkTask {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  qcReportId  String       @unique
  qcReport    QCReport     @relation(fields: [qcReportId], references: [id], onDelete: Cascade)
  description String
  status      ReworkStatus @default(OPEN)
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())

  @@index([orderId, status])
  @@map("rework_task")
}

// ───────────────────────────── Payments ─────────────────────────────
// Milestone payment schedule processed through a payment provider adapter.
// Only a verified provider webhook can mark a transaction as succeeded.

model PaymentMilestone {
  id           String                 @id @default(cuid())
  orderId      String
  order        Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sequence     Int
  label        String
  percentage   Decimal                @db.Decimal(5, 2)
  amount       Decimal                @db.Decimal(14, 2)
  currency     String
  triggerStage MilestoneStage
  status       PaymentMilestoneStatus @default(SCHEDULED)
  dueAt        DateTime?
  paidAt       DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  transactions PaymentTransaction[]

  @@unique([orderId, sequence])
  @@index([status])
  @@map("payment_milestone")
}

model PaymentTransaction {
  id                 String            @id @default(cuid())
  paymentMilestoneId String
  paymentMilestone   PaymentMilestone  @relation(fields: [paymentMilestoneId], references: [id], onDelete: Cascade)
  provider           String
  providerRef        String            @unique
  type               TransactionType
  amount             Decimal           @db.Decimal(14, 2)
  currency           String
  status             TransactionStatus @default(PENDING)
  failureReason      String?
  initiatedById      String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([paymentMilestoneId, createdAt])
  @@map("payment_transaction")
}

/// Every provider webhook delivery, keyed by the provider's event id for idempotency.
model WebhookEvent {
  id             String    @id @default(cuid())
  provider       String
  eventId        String
  type           String
  payload        Json
  signatureValid Boolean
  processedAt    DateTime?
  error          String?
  createdAt      DateTime  @default(now())

  @@unique([provider, eventId])
  @@map("webhook_event")
}

// ───────────────────── Messages, activity, notifications, admin ─────────────────────

/// Order-linked messages between the brand, the manufacturer and admins.
/// milestoneId is set for comments on a specific production milestone.
model Message {
  id          String               @id @default(cuid())
  orderId     String
  order       Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  milestoneId String?
  milestone   ProductionMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  authorId    String
  author      User                 @relation(fields: [authorId], references: [id])
  body        String
  createdAt   DateTime             @default(now())

  @@index([orderId, createdAt])
  @@map("message")
}

/// Append-only history of project and order events. Never updated or deleted by the app.
model ActivityLog {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type      String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([orderId, createdAt])
  @@map("activity_log")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notification")
}

model ContactInquiry {
  id          String        @id @default(cuid())
  name        String
  email       String
  company     String?
  inquiryType String
  subject     String
  message     String
  status      InquiryStatus @default(NEW)
  createdAt   DateTime      @default(now())

  @@index([status, createdAt])
  @@map("contact_inquiry")
}

/// Disputes and problem reports raised by brands or manufacturers.
model IssueReport {
  id          String        @id @default(cuid())
  reporterId  String
  reporter    User          @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  orderId     String?
  order       Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  category    IssueCategory @default(OTHER)
  subject     String
  description String
  status      IssueStatus   @default(OPEN)
  adminNote   String?
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([orderId])
  @@map("issue_report")
}

/// Records sensitive administrative actions. Append-only.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_log")
}
