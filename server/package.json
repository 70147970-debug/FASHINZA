{
  "name": "@fashinza/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fashinza JSON API: Express 5 + Mongoose 8 (MongoDB). Also serves the built client in production.",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "NODE_ENV=production node src/index.js",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.js",
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "@fashinza/shared": "*",
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.9",
    "express": "^5.1.0",
    "mongoose": "^8.19.0",
    "multer": "^2.0.2",
    "zod": "~3.25.76"
  },
  "devDependencies": {
    "supertest": "^7.1.4",
    "vitest": "^3.2.7"
  }
}
