# Fashinza MERN server: optional settings for server/.env
#
# Copy this file to server/.env and fill in what you need. server/.env overrides the root .env, and variables
# set in the real environment override both (see server/src/config.js and docs/mern/README.md).
# Never commit server/.env: it holds secrets.

# ───────────────────────────── Outgoing email (server/src/lib/mail.js) ─────────────────────────────
#
# Fashinza emails password-reset codes and brand-approval news (to the brand and to administrators).
# Without SMTP_USER and SMTP_PASS nothing is sent: every message (recipient, subject and text, including reset
# codes) is written to the server console instead, prefixed "[mail] SMTP not configured — not sent".
#
# Sending through Gmail with an app password:
#   1. Turn on 2-Step Verification for the Google account that will send the email
#      (Google Account → Security → 2-Step Verification). App passwords need it.
#   2. Create an app password: Google Account → Security → 2-Step Verification → App passwords
#      (or https://myaccount.google.com/apppasswords). Name it e.g. "Fashinza".
#   3. Google shows a 16-character password once. Put it in SMTP_PASS (spaces are optional) and the Gmail address
#      in SMTP_USER. Use the app password, never the account's normal password.
#   4. Restart the server. Gmail limits how many messages an account can send per day; use a transactional email
#      provider (any SMTP service) for production traffic.
#
# Other SMTP providers: set SMTP_HOST / SMTP_PORT / SMTP_SECURE to the provider's values
# (port 465 = TLS from the start, SMTP_SECURE=true; port 587 = STARTTLS, SMTP_SECURE=false).

# SMTP server (default smtp.gmail.com)
SMTP_HOST=smtp.gmail.com
# 465 with SMTP_SECURE=true (default), or 587 with SMTP_SECURE=false
SMTP_PORT=465
SMTP_SECURE=true
# The sending account, e.g. your-address@gmail.com
SMTP_USER=
# For Gmail: the 16-character app password (not the account password)
SMTP_PASS=
# Sender shown to recipients (default "Fashinza <SMTP_USER>"). Gmail rewrites other addresses to SMTP_USER.
MAIL_FROM=

# Also write every message as a JSON file into this folder (used by the end-to-end tests to read reset codes).
# Leave empty normally. Relative paths resolve against the repository root.
MAIL_OUTBOX_DIR=

# Links in emails point at APP_URL (default http://localhost:5173, the Vite dev server). Set it to the public
# address of the web app in production, e.g. APP_URL=https://fashinza.example
# APP_URL=

# ───────────────────────────── Profile link checks ─────────────────────────────
# "on" (default): websites and social links are opened when a profile is saved, to confirm they exist.
# "off": no network access; links are stored as "Not checked" (the test environments use this).
# LINK_CHECK=on
